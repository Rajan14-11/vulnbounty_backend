[Unit]
Description=gunicorn daemon
Requires=gunicorn.socket
After=network.target
[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/vulnbounty_backend
ExecStart=/home/ubuntu/env/bin/gunicorn --access-logfile - --workers 3 --bind unix:/home/ubuntu/vulnbounty_backend/vulnbounty/vulnbounty.sock vulnbounty.wsgi:application


[Install]
WantedBy=multi-user.target